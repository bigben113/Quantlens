# Copy to .env and adjust as needed for local development.
# No real secrets belong in this file or in .env when committed.

# --- Spring Boot API (apps/api) ---
API_PORT=8086
# Base URL the API uses to reach the AI service.
AI_SERVICE_BASE_URL=http://localhost:8000
# Timeout (ms) for the API -> AI service health check call.
AI_SERVICE_TIMEOUT_MS=2000
# Origin allowed to call the API via CORS (the web app's origin).
WEB_ORIGIN=http://localhost:5173
# Database connection pool sizing (HikariCP).
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=3000

# --- PostgreSQL ---
# DB_HOST/DB_PORT are for local (non-Docker) development; docker-compose.yml
# overrides DB_HOST to the internal service name ("postgres") automatically.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quantlens
DB_USERNAME=quantlens
DB_PASSWORD=quantlens

# --- FastAPI AI service (apps/ai-service) ---
AI_SERVICE_PORT=8000

# --- React web (apps/web) ---
WEB_PORT=5173
# Base URL the browser uses to reach the Spring Boot API.
VITE_API_BASE_URL=http://localhost:8086
